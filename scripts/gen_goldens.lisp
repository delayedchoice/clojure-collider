(load "/home/bobby/quicklisp/setup.lisp")
(ql:quickload "cl-collider" :silent t)
(in-package :sc-user)

(defun dump (name thunk)
  (let ((sc::*synthdef* (make-instance 'sc::synthdef :name name)))
    (funcall thunk)
    (sc::build-synthdef sc::*synthdef*)
    (let ((bytes (sc::encode-synthdef sc::*synthdef*)))
      (with-open-file (s (format nil "/tmp/cl-~a.scsyndef" name)
                         :direction :output :element-type '(unsigned-byte 8)
                         :if-exists :supersede)
        (write-sequence bytes s))
      (format t "~a: ~d ugens, ~d consts, ~d bytes~%"
              name (length (sc::children sc::*synthdef*))
              (length (sc::constants sc::*synthdef*)) (length bytes))
      (format t "  ugens: ~s~%" (mapcar #'sc::name (sc::children sc::*synthdef*)))
      (format t "  consts: ~s~%" (coerce (sc::constants sc::*synthdef*) 'list))
      (format t "  controls: ~s names: ~s~%"
              (coerce (sc::controls sc::*synthdef*) 'list)
              (coerce (sc::control-names sc::*synthdef*) 'list)))))

(dump "reorder" (lambda ()
                  (let ((a (sin-osc.ar 440 0 1 0))
                        (b (sin-osc.ar 441 0 1 0)))
                    (saw.ar a 1 0)
                    (saw.ar b 1 0))))
(dump "ctl" (lambda ()
              (with-controls ((freq 440) (amp 0.5))
                (saw.ar freq amp 0))))
(dump "groups" (lambda ()
                 (with-controls ((gate 0 :tr) (freq 440 :ar) (amp 0.5))
                   (saw.ar freq amp gate))))
(dump "diamond" (lambda ()
                  (let ((a (sin-osc.ar 440 0 1 0)))
                    (saw.ar 300 (saw.ar 100 a 0) (saw.ar 200 a 0)))))
(dump "dsine" (lambda ()
                (with-controls ((freq 440))
                  (out.ar 0 (sin-osc.ar freq 0 1 0.2)))))
(dump "varlag" (lambda ()
                 ;; scalar `in` is illegal upstream (HPZ1 rate check);
                 ;; drive with an ar carrier like a real lag input
                 (out.ar 0 (var-lag.ar (sin-osc.ar 440 0 1 0) 0.1))))
(dump "playtail" (lambda ()
                   (let ((result (sin-osc.ar 440 0 1 0.2)))
                     (destructuring-bind (dt buses gate gain lag)
                         (sc::make-control
                          (list (list "fade" 0.02) (list "out-bus" 0.0)
                                (list "gate" 1.0) (list "gain" 0.5)
                                (list "lag" 1.0)))
                       (let* ((start-val (sc::<=~ dt 0))
                              (env (env-gen.kr (env (list start-val 1 0) (list 1 1) :lin 1)
                                               :gate gate :time-scale dt :act :free)))
                         (setf result (sc::*~ env result))
                         (out.ar buses (sc::*~ result (var-lag.kr gain lag))))))))
(dump "volume" (lambda ()
                 ;; NB: volume.lisp's own `*` is CL's multiply and throws;
                 ;; `*~` (our ops/*) is the working UGen multiply.
                 (with-controls ((amp 0.5) (gate 1))
                   (x-out.ar 0 (linen.kr gate 0.01 1.0 0.05 :act :free)
                             (sc::*~ (in.ar 0 2) (lag.kr amp 0.1))))))
(dump "select" (lambda ()
                 (out.ar 0 (select.ar (sin-osc.kr 1)
                                      (list (sin-osc.ar 440 0 1 0) (sin-osc.ar 550 0 1 0))))))
(dump "klang" (lambda ()
                (out.ar 0 (klang.ar (list (list 800 1071) (list 1.0 1.0) (list 0.0 0.0))))))
(dump "demand" (lambda ()
                 (out.ar 0 (duty.ar 1.0 :reset 0.0 :level 1.0))))
